# ==============================================================================
# Curiosity On Demand - Environment Configuration
# ==============================================================================

# --- Google Gemini AI ---
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
RESEARCH_MODEL=gemini-3.8-flash
EVALUATOR_MODEL=gemini-3.8-flash
SCRIPT_MODEL=gemini-3.8-flash
ANIMATOR_MODEL=gemini-3.8-flash
NARRATION_PLANNER_MODEL=gemini-3.8-flash
TTS_MODEL=gemini-3.1-flash-tts-preview
DEFAULT_TTS_VOICE=Zephyr
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
DEFAULT_SCENE_DURATION_SECONDS=10
MAX_RESEARCH_ITERATIONS=3
DEFAULT_VIDEO_DURATION_MINUTES=5

# --- Concurrency & Pipeline Performance ---
# Maximum concurrent Playwright browser scene rendering sessions (default: 5)
RENDER_CONCURRENCY=5
# Maximum concurrent Gemini TTS speech synthesis tasks (default: 5)
TTS_CONCURRENCY=5
# Maximum concurrent Gemini LLM scene canvas code generation tasks (default: 5)
ANIMATION_CONCURRENCY=5
# Maximum concurrent FFmpeg audio/video retiming and muxing processes (default: 5)
FFMPEG_CONCURRENCY=5

# --- Telegram Bot ---
# Create a bot via @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of allowed user IDs or usernames (empty allows all users)
TELEGRAM_ALLOWED_USERS=
# Maximum video size in MB allowed for Telegram upload (default: 49)
TELEGRAM_MAX_VIDEO_SIZE_MB=49.0
# Maximum duration in seconds for video preview sent via Telegram when full video exceeds limits (default: 180)
TELEGRAM_PREVIEW_MAX_DURATION_SECONDS=180.0

# --- Storage & Database ---
STORAGE_DIR=storage
SQLITE_DB_PATH=storage/curiosity.db
