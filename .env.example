# ==============================================================================
# Curiosity On Demand - Environment Configuration
# ==============================================================================

# --- Google Gemini AI ---
# Obtain your API key from Google AI Studio (https://aistudio.google.com/) or Vertex AI Express Mode
GEMINI_API_KEY=your_gemini_api_key_here
# Set to true when using a Vertex AI API key (e.g. AQ.Ab8RN6...)
GEMINI_USE_VERTEXAI=false
# Optional: Google Cloud project ID/number and location when using Vertex AI (default location: global)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
RESEARCH_MODEL=gemini-3.8-flash
EVALUATOR_MODEL=gemini-3.8-flash
SCRIPT_MODEL=gemini-4-argon
ANIMATOR_MODEL=gemini-4-argon
NARRATION_PLANNER_MODEL=gemini-3.8-flash
TTS_MODEL=gemini-3.8-flash-tts
DEFAULT_TTS_VOICE=Zephyr
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VERTICAL_VIDEO_WIDTH=1080
VERTICAL_VIDEO_HEIGHT=1920
VERTICAL_VIDEO_THRESHOLD_SECONDS=120
DEFAULT_SCENE_DURATION_SECONDS=10
MAX_RESEARCH_ITERATIONS=3
DEFAULT_VIDEO_DURATION_MINUTES=5

# --- Concurrency & Pipeline Performance ---
# Maximum concurrent Gemini TTS speech synthesis tasks (default: 3)
TTS_CONCURRENCY=3
# Maximum concurrent Gemini LLM scene canvas code generation tasks (default: 3)
ANIMATION_CONCURRENCY=3
# Maximum concurrent Playwright browser scene rendering sessions (default: 5)
RENDER_CONCURRENCY=5
# Maximum concurrent FFmpeg audio/video retiming and muxing processes (default: 5)
FFMPEG_CONCURRENCY=5

# --- Telegram Bot ---
# Create a bot via @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of allowed user IDs or usernames (empty allows all users)
TELEGRAM_ALLOWED_USERS=
# Maximum video size in MB allowed for Telegram upload (default: 49)
TELEGRAM_MAX_VIDEO_SIZE_MB=49.0
# Maximum duration in seconds for video preview sent via Telegram when full video exceeds limits (default: 60)
TELEGRAM_PREVIEW_MAX_DURATION_SECONDS=60.0
# Timeout in seconds for Telegram media uploads (default: 300)
TELEGRAM_UPLOAD_TIMEOUT_SECONDS=300.0
# Timeout in seconds for standard Telegram API requests (default: 60)
TELEGRAM_REQUEST_TIMEOUT_SECONDS=60.0

# --- Storage & Database ---
STORAGE_DIR=storage
SQLITE_DB_PATH=storage/curiosity.db

# --- YouTube Data API Publishing ---
# Configure either direct OAuth tokens (recommended for servers/Docker) or token file:
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_TOKEN_FILE=storage/youtube_token.json
YOUTUBE_CLIENT_SECRETS_FILE=
# Video privacy status: public, unlisted, or private (default: public)
YOUTUBE_DEFAULT_PRIVACY_STATUS=public
# YouTube Category ID (27 = Education, 28 = Science & Technology)
YOUTUBE_DEFAULT_CATEGORY_ID=27
# Comma-separated list of default tags
YOUTUBE_DEFAULT_TAGS=CuriosityOnDemand,Education,Animation
