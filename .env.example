# ==============================================================================
# Curiosity On Demand - Environment Configuration
# ==============================================================================

# --- Google Gemini AI ---
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
RESEARCH_MODEL=gemini-3.7-flash

# --- Telegram Bot ---
# Create a bot via @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of allowed user IDs (empty allows all users)
TELEGRAM_ALLOWED_USERS=

# --- Gemini Audio / TTS Configuration ---
# Model & Voice used for speech narration. Use 'random' to pick a new voice per creation,
# or specify one from: Zephyr, Puck, Charon, Kore, Fenrir, Leda, Orus, Aoede, Callirrhoe,
# Autonoe, Enceladus, Iapetus, Umbriel, Algieba, Despina, Erinome, Algenib, Rasalgethi,
# Laomedeia, Achernar, Alnilam, Schedar, Gacrux, Pulcherrima, Achird, Zubenelgenubi,
# Vindemiatrix, Sadachbia, Sadaltager, Sulafat
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=random

# --- YouTube Data API v3 (OAuth2 Client) ---
# Download client secrets from Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=storage/youtube_token.json

# --- Storage & Directories ---
STORAGE_DIR=storage
MEDIA_OUTPUT_DIR=storage/media
SQLITE_DB_PATH=storage/curiosity.db

# --- Pipeline Parameters ---
MAX_RESEARCH_ITERATIONS=3
DEFAULT_VIDEO_WIDTH=1920
DEFAULT_VIDEO_HEIGHT=1080
SHORT_VIDEO_WIDTH=1080
SHORT_VIDEO_HEIGHT=1920
DEFAULT_FPS=30
